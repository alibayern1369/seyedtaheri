# Admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-long-random-string

# Upstash Redis (required for persistent admin saves on Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google reCAPTCHA v3 keys are configured in Admin → Security (not env).
